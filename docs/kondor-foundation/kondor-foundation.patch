+"use strict";
+const assert = require("node:assert/strict"), fs = require("node:fs"), path = require("node:path"), vm = require("node:vm");
+const dependencies = require("node:module").createRequire(process.env.KONDOR_TEST_PACKAGE || path.join(__dirname, "../package.json"));
+const sdk = dependencies("koilib"), ts = dependencies("typescript");
+const root = path.join(__dirname, "..");
+// Match public/sandbox.html: its ABI serializer comes from koilib's browser
+// bundle, not the Node entry point with a separately resolved protobuf version.
+const sandbox = { TextEncoder, TextDecoder, Uint8Array, Buffer, crypto: require("node:crypto").webcrypto };
+sandbox.window = sandbox;
+sandbox.self = sandbox;
+vm.runInNewContext(fs.readFileSync(path.join(path.dirname(dependencies.resolve("koilib")), "../dist/koinos.js"), "utf8"), sandbox);
+const database = {};
+const storageContext = { exports: {}, chrome: { storage: { local: {
+  get: (keys, cb) => cb(Object.fromEntries(keys.filter(k => database[k] !== undefined).map(k => [k, database[k]]))),
+  set: (value, cb) => { Object.assign(database, value); cb(); },
+} } } };
+vm.runInNewContext(ts.transpileModule(fs.readFileSync(path.join(root, "src/ts/storage.ts"), "utf8"), { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 } }).outputText, storageContext);
+const storage = storageContext.exports;
+function component(file, extras = {}) {
+  let source = fs.readFileSync(path.join(root, file), "utf8");
+  if (source.includes("<script>")) source = source.split("<script>")[1].split("</script>")[0];
+  source = source.replace(/^import[\s\S]*?;\s*$/gm, "").replace("export default {", "module.exports = {");
+  const context = { module: { exports: {} }, ...sdk, storage, TextEncoder, TextDecoder,
+    Message: {}, ViewHelper: {}, Storage: {}, Sandbox: {}, Unlock: {},
+    console: { log() {}, warn() {}, error() {} }, process: { env: {} }, ...extras };
+  vm.runInNewContext(source, context);
+  return context.module.exports;
+}
+(async () => {
+  const foundation = "EiAIKVvm6-V2qmsmUvPJy09vCCLbtn9lHFpwrJbcTIEWRQ==";
+  // Simulate upgrading a wallet that saved only Mainnet and Harbinger.
+  database.networks = structuredClone(storage.DEFAULT_NETWORKS.slice(0, 2));
+  database.networks[0].rpcNodes = ["https://custom-mainnet.invalid"];
+  const networks = await storage.getNetworks();
+  assert.equal(networks.length, 3);
+  assert.equal(networks[0].rpcNodes[0], "https://custom-mainnet.invalid");
+  assert.equal(networks.find(n => n.tag === "foundation").chainId, foundation);
+  assert.equal(networks.find(n => n.tag === "foundation").manaMeter, undefined);
+  const mixin = component("src/shared/mixins/Storage.js");
+  const tokens = await mixin.methods._getTokens.call({ _read: async () => undefined });
+  assert.equal(tokens.filter(t => t.network === "foundation").length, 2);
+  const menu = component("src/index/components/AvatarMenu.vue");
+  const menuApp = { $store: { state: { networks, currentNetwork: 0 } }, _setCurrentNetwork: storage.setCurrentNetwork, closeDropdown() {} };
+  await menu.methods.selectNetwork.call(menuApp, 2);
+  assert.equal(await storage.getCurrentNetwork(), "foundation");
+  assert.equal(menu.computed.isTestnetMode.call(menuApp), true);
+  const widgets = component("src/index/components/WidgetTokens.vue", { emptyToken: "empty.png", WalletInfo: {}, TabPanel: {}, mapActions: () => ({}) });
+  let savedTokens;
+  await widgets.methods.updateSavedTokens.call({
+    $store: { state: { networks: networks.filter(n => n.tag === "foundation") } },
+    _getTokens: async () => tokens.filter(t => t.network === "foundation"),
+    _setTokens: async t => { savedTokens = t; },
+    _getAbi: async () => { throw Error("must not load absent nicknames service"); },
+  });
+  assert.equal(savedTokens.length, 2);
+  const signer = sdk.Signer.fromSeed("Kondor Foundation regression fixture"), address = signer.getAddress();
+  const customId = sdk.Signer.fromSeed("Kondor demo app fixture").getAddress();
+  const abi = { methods: { create_record: { entry_point: 1, argument: "app.create_args", return: "" } }, koilib_types: { nested: { app: { nested: { create_args: { fields: { title: { type: "string", id: 1 } } } } } } } };
+  const serializer = new sdk.Serializer(abi.koilib_types);
+  const transaction = await sdk.Transaction.prepareTransaction({ header: { payer: address, chain_id: foundation, nonce: "KAE=", rc_limit: "200000000" }, operations: [{ call_contract: { contract_id: customId, entry_point: 1, args: sdk.utils.encodeBase64url(await serializer.serialize({ title: "Feature request" }, "app.create_args")) } }] });
+  const view = component("src/popup/views/2-SignSendTransaction.vue");
+  const state = { accounts: [{ address, name: "Test account", privateKey: signer.getPrivateKey("wif") }] };
+  const app = { $store: { state }, ...view.data.call({ $store: { state } }), request: { args: { signerAddress: address, transaction: structuredClone(transaction), abis: { [customId]: abi } } } };
+  for (const [name, fn] of Object.entries(view.methods)) app[name] = fn.bind(app);
+  Object.assign(app, { _getAccounts: async () => state.accounts, _getNetworks: async () => networks, _getTokens: async () => tokens,
+    _getAbi: async () => undefined, newSandboxSerializer: async types => new sandbox.Serializer(types), alertDanger() {} });
+  let metadataCalls = 0;
+  const oldFetchAbi = sdk.Contract.prototype.fetchAbi;
+  sdk.Contract.prototype.fetchAbi = async () => { metadataCalls++; throw Error("Foundation must use the supplied ABI without an unsupported metadata RPC"); };
+  try {
+    await app.decodeTransaction();
+    assert.equal(app.payer, address);
+    assert.equal(app.network.tag, "foundation");
+    assert.equal(app.optimizeMana, false);
+    assert.equal(app.freeManaSharer, null);
+    assert.equal(app.nicknames, null);
+    assert.equal(metadataCalls, 0);
+    assert.equal(app.operations.length, 1);
+    assert.equal(app.operations[0].title, "Create record");
+    assert.ok(app.operations[0].args.some(a => a.data === "Feature request"));
+    await app.buildTransaction();
+    await app.signTransaction();
+    assert.equal(app.transaction.transaction.id, transaction.id);
+    assert.deepEqual(app.transaction.transaction.operations, transaction.operations);
+    assert.ok((await sdk.Signer.recoverAddresses(app.transaction.transaction)).includes(address));
+    if (process.env.KONDOR_LIVE_DRAFT) {
+      // Optional read-only check of the exact app's unsigned payload. No keys
+      // are supplied for this account; this block only decodes and rebuilds.
+      const { draft } = JSON.parse(fs.readFileSync(process.env.KONDOR_LIVE_DRAFT, "utf8"));
+      app.request.args = { signerAddress: draft.signerAddress, transaction: draft.transaction,
+        abis: { [draft.contractId]: draft.abi, [draft.guardId]: draft.guardAbi } };
+      await app.decodeTransaction();
+      assert.equal(app.payer, draft.transaction.header.payer);
+      assert.equal(app.operations.length, draft.transaction.operations.length);
+      await app.buildTransaction();
+      assert.equal(app.transaction.transaction.id, draft.transaction.id);
+      console.log("PASS: live app draft payer, both operation reviews and original transaction ID");
+    }
+    app.request.args.transaction.header.chain_id = "unknown-chain";
+    await assert.rejects(() => app.decodeTransaction(), /does not support.*chain/);
+  } finally { sdk.Contract.prototype.fetchAbi = oldFetchAbi; }
+  let submitted;
+  const tokenView = component("src/index/views/tokens/SendToken.vue", { router: { push() {} } });
+  const provider = {
+    getNextNonce: async () => "KAE=",
+    sendTransaction: async tx => { submitted = structuredClone(tx); return { transaction: { ...tx, wait: async () => ({ blockNumber: 1 }) }, receipt: {} }; },
+    wait: async () => ({ blockNumber: 1 }),
+  };
+  signer.provider = provider;
+  const koin = tokens.find(t => t.network === "foundation" && t.nickname === "koin");
+  const transfer = {
+    network: networks.find(n => n.tag === "foundation"), provider, signer,
+    serializer: new sandbox.Serializer(sdk.utils.tokenAbi.koilib_types), miniTokens: [koin],
+    tokenId2: koin.contractId, tokenDecimals: 8, address, payer: address, maxMana: 2,
+    amount: "1", to: customId, memo: "testnet fixture", alertSuccess() {}, alertDanger() {},
+    _getAbi: async () => { throw Error("must not request absent free-mana ABI"); },
+  };
+  await tokenView.methods.transfer.call(transfer);
+  assert.equal(submitted.header.chain_id, foundation);
+  assert.equal(submitted.header.payer, address);
+  assert.ok((await sdk.Signer.recoverAddresses(submitted)).includes(address));
+  console.log("PASS: existing-wallet network migration, Foundation tokens, operation review, correct payer, disabled unavailable mana services and valid transaction signature");
+})().catch(e => { console.error(e); process.exitCode = 1; });
