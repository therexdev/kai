# Operational flags shipped through git — loaded at boot by lib/env-file.js.
# The real environment ALWAYS wins: anything set in systemd's on-box
# EnvironmentFile (/opt/koinos/kai.env) overrides this file, which keeps it
# safe for emergency on-box overrides.
#
#   *** NO SECRETS IN THIS FILE — IT IS COMMITTED TO GIT. ***
#   Tokens, WIFs, passwords live on-box in /opt/koinos/kai.env only.
#
# One flag change per commit; the commit message carries the why. The
# 1-minute auto-deploy makes a merge to the production branch live.

# Transactional ledger store (durable phase 1; probed by
# scripts/probe-durable-store.js + probe-settle-integrity.js). First boot
# with this set migrates the flat files into kai-store.sqlite inside a
# single transaction (originals kept as *.json.migrated). Rollback:
# scripts/db-export.js, then remove this line. If the box's node lacks
# node:sqlite the server falls back to json LOUDLY — /api/health `store`
# shows the mode that actually engaged.
KAI_STORE=sqlite

# Anti-Sybil eligibility gate — deliberately NOT armed.
# Live fleet 2026-08-17: every worker r≈0.25, elig=0. Arming today would
# zero ALL bootstrap-pool payouts, founder machines included. Arm
# (KAI_REPUTATION_ENFORCE=1) once real workers clear the gate (r>0.45:
# roughly a week of age plus paid jobs plus clean challenges). Evidence:
# /admin/api/shadow-trends and per-worker `reputation` in
# /scheduler/network/status.
