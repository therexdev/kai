# Operational flags shipped through git — loaded at boot by lib/env-file.js.
# The real environment ALWAYS wins: anything set in systemd's on-box
# EnvironmentFile (/opt/koinos/kai.env) overrides this file, which keeps it
# safe for emergency on-box overrides.
#
#   *** NO SECRETS IN THIS FILE — IT IS COMMITTED TO GIT. ***
#   Tokens, WIFs, passwords live on-box in /opt/koinos/kai.env only.
#
# One flag change per commit; the commit message carries the why. The
# 1-minute auto-deploy makes a merge to the production branch live.

# Transactional ledger store (durable phase 1; probed by
# scripts/probe-durable-store.js + probe-settle-integrity.js). First boot
# with this set migrates the flat files into kai-store.sqlite inside a
# single transaction (originals kept as *.json.migrated). Rollback:
# scripts/db-export.js, then remove this line. If the box's node lacks
# node:sqlite the server falls back to json LOUDLY — /api/health `store`
# shows the mode that actually engaged.
KAI_STORE=sqlite

# Anti-Sybil eligibility gate — deliberately NOT armed.
# Live fleet 2026-08-17: every worker r≈0.25, elig=0. Arming today would
# zero ALL bootstrap-pool payouts, founder machines included. Arm
# (KAI_REPUTATION_ENFORCE=1) once real workers clear the gate (r>0.45:
# roughly a week of age plus paid jobs plus clean challenges). Evidence:
# /admin/api/shadow-trends and per-worker `reputation` in
# /scheduler/network/status.
#
# ROLLOUT ORDER — owner decision 2026-08-19:
#   1. Device-fingerprint binding enforces FIRST (signal #3; shadow data =
#      fingerprintGroups in every epoch summary since the fingerprint deploy).
#   2. Reputation gate at 0.45 — the shipped KAI_REP_GATE default, unchanged.
#   3. TWO WEEKS of clean shadow from the production deploy of the
#      fingerprint signal before ANY enforcement flag flips. The clock
#      starts at that deploy's first epoch, not at this commit.
# Each arming is its own one-line change here with the evidence in the
# commit message.

# §51 price oracle — TESTNET REHEARSAL on the vKOIN/USDT market.
# Runbook + rationale: kaiapp/docs/oracle-rehearsal.md. This is NOT a
# KAI<->KOIN peg: vKOIN is simply a real, moving number that exercises the
# oracle machinery (median across sources -> EMA -> step/floor/ceil breakers
# -> stale-hold) on live data before mainnet. Testnet only, fully reversible
# by deleting this block. Break-tested offline: scripts/probe-oracle.js (8).
# Two independent aggregators read the SAME Ethereum token for
# median-of-two redundancy: either can carry alone if the other is down, and
# neither alone can move a median. Watch it converge (10%/epoch step cap, so
# over epochs, not seconds) at /scheduler/pricing — `status` walks
# anchor -> live, or stale-hold if every feed is down.
KAI_PRICE_SOURCES=[{"url":"https://api.dexscreener.com/latest/dex/tokens/0xa50ad3a559a10f384a5bb2e27516f63e0b937b1a","path":"pairs.0.priceUsd"},{"url":"https://api.geckoterminal.com/api/v2/networks/eth/tokens/0xa50ad3a559a10f384a5bb2e27516f63e0b937b1a","path":"data.attributes.price_usd"}]
# Anchor doubles as the all-sources-down fallback; floor/ceil bracket ~$0.0087.
KAI_REF_USD=0.0087
KAI_PRICE_FLOOR_USD=0.001
KAI_PRICE_CEIL_USD=0.05
KAI_PRICE_ALPHA=0.25
KAI_PRICE_MAX_STEP_PCT=10

# §20 settlement splits — ACTIVATED 2026-08-17 (owner decision).
# With no treasury configured the verification + protocol shares folded back
# into compute (full pass-through to providers). Setting this routes them to
# the treasury instead: verifyBps 300 (3%) + protocolBps 700 (7%) of PAID chat
# value. Providers keep 90% of paid value plus 100% of the bootstrap pool;
# free-tier traffic has no value to split. Confirm live at /scheduler/pricing
# -> splits.active === true.
#
# NOT a secret — a receiving address on a public chain, and this file is
# public. Checksum-verified before commit (25-byte payload, version 0x00,
# base58 round-trip identical).
KAI_TREASURY_ADDR=1K1AUovu5NjjPcaTxmde6wPB8Y8PQGFV3E
